<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/IndustrialCopilot.Api/IndustrialCopilot.Api.csproj" /><ProjectReference Include="../../src/IndustrialCopilot.Worker/IndustrialCopilot.Worker.csproj" /><ProjectReference Include="../IndustrialCopilot.Corpus/IndustrialCopilot.Corpus.csproj" /></ItemGroup>
  <!-- The opt-in harness supplies its own explicit configuration. Do not merge
       API/Worker appsettings into one ambiguous published demo configuration. -->
  <Target Name="ExcludeReferencedHostSettings" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json'" />
    </ItemGroup>
  </Target>
</Project>
