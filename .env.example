# Docker-only LOCAL synthetic evaluator setup. No committed passwords or tokens.
# setup generates persistent random credentials, database password and internal TLS.
COMPOSE_PROJECT_NAME=maintenance
WEB_PORT=8080
# Demo needs no model, key, .NET or Node on the host. Only this mode is automatically proven.
DEMO_PROVIDER=Demo
# Optional existing real provider adapters: OpenAi or Ollama. Not production deployment mode.
# Models are never installed automatically. Set actual models/profile/dimensions before use.
# Non-loopback Ollama requires HTTPS trusted by the container (e.g. an existing TLS gateway).
# Plain HTTP host.docker.internal is deliberately rejected by the existing security policy.
OLLAMA_ENDPOINT=https://host.docker.internal:11434/
CHAT_MODEL=demo-test-v1
EMBEDDING_MODEL=demo-test-v1
EMBEDDING_PROFILE=synthetic-demo-v1
EMBEDDING_REVISION=deterministic-four-features-v1
EMBEDDING_DIMENSIONS=4
# Required only for OpenAi. Keep .env private and untracked.
OPENAI_API_KEY=
